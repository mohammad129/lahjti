# Lahjti (لهجتي) Secure Backend AI Gateway Environment Variables
# Copy to `.env` for local backend development
# NEVER commit production API keys or credentials to version control.

PORT=3000
NODE_ENV=development

# AI Provider Selection: 'mock' | 'gemini' | 'openai'
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_FAST_MODEL=gpt-4o-mini
AI_ADVANCED_MODEL=gpt-4o-mini

# API Credentials (leave blank for mock mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AI_TIMEOUT_MS=10000
MAX_RESPONSE_LENGTH=1000

# Auth Configuration
JWT_SECRET=development_jwt_secret_lahjti_change_in_production

# PostgreSQL Database (leave blank for local in-memory development)
DATABASE_URL=
