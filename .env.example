# Lahjti (لهجتي) - Environment Variables Template
# Copy this file to `.env` (or pass as --dart-define / --dart-define-from-file)
# NEVER commit your real `.env` file with production secrets to version control.

# Application Environment (dev | staging | prod)
APP_ENV=dev

# Backend API Configuration (Secure Gateway)
API_BASE_URL=https://api-dev.lahjti.com/api/v1
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=15000

# Backend Server Configuration (Configured ONLY on server-side)
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Payment Provider Configuration (Future steps)
# REVENUE_CAT_API_KEY=
# STRIPE_PUBLISHABLE_KEY=

# Analytics & Monitoring
# SENTRY_DSN=
